
digraph Architecture {
 graph [rankdir=TB, bgcolor="#ffffff", pad="0.35", nodesep="0.5", ranksep="0.65", splines=polyline, fontname="DejaVu Sans", label="AI-Assisted Contractor Proposal Triage — System Architecture", labelloc=t, fontsize=20, fontcolor="#142b3a"]
 node [shape=box, style="rounded,filled", fillcolor="#eff5fa", color="#8da5b6", penwidth=1.2, fontname="DejaVu Sans", fontsize=11, margin="0.18,0.13"]
 edge [color="#607d90", penwidth=1.4, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9]
 admin [label="Admin UI\nCriteria • weights • rubrics", fillcolor="#e4f1ff"]
 reviewer [label="Reviewer UI\nUpload batch • review flags • award", fillcolor="#e4f1ff"]
 backend [label="Application Backend\nBatch orchestration • access control", fillcolor="#dbeafe"]
 database [label="Versioned Database + Audit Log\nConfig snapshots • evidence • scores\nreviews • decisions", fillcolor="#f0eaff"]
 pdf [label="PDF Processor\nText/tables • page references"]
 ai [label="AI Evidence Extractor\nStructured evidence • citations\nuncertainty • injection flags", fillcolor="#fff1d9"]
 rules [label="Deterministic Rules & Scoring\nMandatory checks • weighted scores\neligible / flagged / ineligible", fillcolor="#e0f4e9"]
 results [label="Provisional Results\nRankings • explanations • review queue"]
 human [label="Human Review & Resolution\nVerify flags • correct evidence\napprove finalized ranking", fillcolor="#e4f1ff"]
 final [label="Final Ranking + Human Award Decision\nJustification recorded", fillcolor="#d9f4e3"]
 {rank=same; admin; reviewer}
 {rank=same; database; pdf}
 admin -> backend [label="publish version"]
 reviewer -> backend [label="upload/select"]
 backend -> database [label="read/write", dir=both]
 backend -> pdf [label="batch PDFs"]
 pdf -> ai [label="document text"]
 database -> ai [label="criteria snapshot", constraint=false]
 ai -> rules [label="evidence JSON"]
 database -> rules [label="rules/weights", constraint=false]
 rules -> results [label="statuses/scores"]
 results -> human [label="flags and evidence"]
 human -> rules [label="verified corrections\nre-evaluate", constraint=false, color="#a46d25"]
 human -> final [label="resolve all blockers"]
 final -> database [label="persist decisions", constraint=false]
 results -> database [label="persist provisional", constraint=false]
}
